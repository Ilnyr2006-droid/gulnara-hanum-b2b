# Set these as server-side environment variables. Do not paste into HTML or app.js.
RESEND_API_KEY=re_your_secret_key
RESEND_FROM=Gulnara Hanum <leads@YOUR-VERIFIED-DOMAIN.ru>
LEADS_TO=gh150874@mail.ru
# Keep false until the owner has approved the final privacy notice, operator
# details, consent wording, retention periods, and Resend data-processing setup.
PERSONAL_DATA_PROCESSING_APPROVED=false
# Optional: set to exactly "true" only if trusted ingress overwrites X-Real-IP
# and direct access to the Node endpoint is blocked.
# The endpoint accepts it only as one exact IPv4/IPv6 value; default is disabled.
TRUST_X_REAL_IP=false
# For the local Node server only:
PORT=3000
