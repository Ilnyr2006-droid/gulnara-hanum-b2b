server {
    listen 8095;
    listen [::]:8095;
    server_name 222.167.248.51;

    root /var/www/gulnara-hanum-b2b/public;
    index index.html;
    client_max_body_size 16k;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /api/lead {
        limit_req zone=gulnara_leads burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3015;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = / {
        try_files /index.html =404;
    }

    location = /index.html { try_files $uri =404; }
    location = /app.js { try_files $uri =404; }
    location = /enhancements.css { try_files $uri =404; }
    location = /privacy.html { try_files $uri =404; }
    location = /robots.txt { try_files $uri =404; }
    location = /llms.txt { try_files $uri =404; }

    location ^~ /assets/ {
        try_files $uri =404;
    }

    location / { return 404; }
}
